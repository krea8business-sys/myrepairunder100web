# ───────────────────────────────────────────────────────────────
# MyRepairUnder100 — environment variables (placeholders only)
# Copy to .env and fill in. NEVER commit real values.
# ───────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# Set to "true" for managed Postgres that requires SSL (Render, Neon, Supabase…)
DATABASE_SSL="false"
DATABASE_POOL_MAX="10"

# Long random strings (required in production). Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-64-hex-characters"
HASH_SECRET="replace-with-another-64-hex-characters"

# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# First admin account — used ONLY by `npm run db:seed` when no admin exists yet.
# Remove from the environment after the first deploy.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Optional integrations (leave blank to keep disabled) ─────────
# Email via Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM=""               # e.g. "MyRepairUnder100 <bookings@yourdomain.in>"
ADMIN_NOTIFY_EMAIL=""       # where new-booking alerts go

# SMS via MSG91 (requires a DLT-registered template)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# WhatsApp Business Cloud API (Meta) — template with 3 body variables: name, booking ID, status
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"

# Signed webhook for every booking event (e.g. Google Apps Script → Google Sheet). See docs/google-sheets-webhook.gs
BOOKING_WEBHOOK_URL=""
BOOKING_WEBHOOK_SECRET=""

# Auto-fetch location (reverse geocoding). Works out of the box with free OpenStreetMap Nominatim.
# Optional: a Google Geocoding key (server-side, restricted) gives better Indian street-level results.
GOOGLE_MAPS_API_KEY=""
NOMINATIM_EMAIL=""          # your contact email, recommended by Nominatim's usage policy
GEOCODER=""                 # set to "none" to switch reverse geocoding off

# Razorpay — NOT wired into checkout yet (see README → Known limitations)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=""

# Tests only: a disposable database that integration tests may wipe
TEST_DATABASE_URL=""
